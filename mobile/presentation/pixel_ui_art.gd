static var cache: Dictionary = {}

static func heading(canvas: CanvasItem,value: String,baseline: Vector2,scale: int,hue: Color) -> void:
	var title := value.to_upper()
	var origin := (baseline-Vector2((title.length()*6-1)*scale/2.0,7*scale)).round()
	for i in range(title.length()):
		var rows: Array = GLYPHS.get(title.substr(i,1),[])
		for y in range(rows.size()):
			var row: String = rows[y]
			for x in range(5):
				if row.substr(x,1)!="1": continue
				var point := origin+Vector2((i*6+x)*scale,y*scale)
				canvas.draw_rect(Rect2(point+Vector2(1,2),Vector2.ONE*scale),Color("#100e17"))
				canvas.draw_rect(Rect2(point,Vector2.ONE*scale),hue if y>1 else hue.lightened(0.20))

static func icon_image(id: String,hue: Color) -> Image:
	var image := Image.create_empty(9,9,false,Image.FORMAT_RGBA8)
	image.fill(Color.TRANSPARENT)
	var rows: Array = ICONS.get(id,ICONS.rune)
	var palette := [Color.TRANSPARENT,hue.darkened(0.48),hue,hue.lightened(0.68)]
	for y in range(9):
		var row: String = rows[y]
		for x in range(9):
			var token := row.substr(x,1)
			if token!=".": image.set_pixel(x,y,palette[int(token)])
	return image

static func icon(id: String,hue: Color) -> Texture2D:
	var key := id+":"+hue.to_html()
	if not cache.has(key): cache[key]=ImageTexture.create_from_image(icon_image(id,hue))
	return cache[key]

static func upgrade_icon(id: String,definition: Dictionary) -> String:
	if definition.has("affinity"): return str(definition.affinity)
	match id:
		"vitality","hybrid","relic_heart": return "heart"
		"power","focus","relic_power": return "power"
		"haste","stride","rapid","fae","flow","relic_focus": return "speed"
		"fortify": return "ward"
		"stone": return "stone"
		"wingward": return "wing"
		"flametrail": return "fire"
	return "rune"
